TG_BOT_TOKEN='YOUR_TG_BOT_TOKEN'
ALLOWED_CHAT_ID='YOUR_CHAT_ID'
VERIFICATION_TIMEOUT_SECONDS=30
JOIN_VERIFICATION_ENABLED=1
# 1/0 = verification only
# 0/1 = gigachat only
# 1/1 = double verification
# 0/0 = disable first-message checks
FIRST_MESSAGE_VERIFICATION_ENABLED=1
GIGACHAT_SPAM_MODERATION_ENABLED=0
GIGACHAT_AUTH_KEY=''
GIGACHAT_MODEL='GigaChat-2'
GIGACHAT_SCOPE='GIGACHAT_API_PERS'
SPAM_SCORE_THRESHOLD=4
GIGACHAT_REQUEST_TIMEOUT_SECONDS=20
# Set 0 only if the server has TLS/certificate issues with GigaChat.
GIGACHAT_VERIFY_SSL=1
